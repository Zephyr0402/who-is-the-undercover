# Override the backend base URL used by the app.
#
# Web (production export): leave unset to derive it from the page URL.
# Native (production): defaults to https://www.bvshen.com/who-is-the-undercover
# Native (development): defaults to the Expo dev-server host on port 8000.
#
# EXPO_PUBLIC_API_BASE_URL=https://www.bvshen.com/who-is-the-undercover
